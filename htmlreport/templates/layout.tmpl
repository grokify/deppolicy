{{define "head"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DepPolicy — {{.Title}}</title>
<style>
:root{--bg:#fff;--fg:#1a1a2e;--muted:#6b7280;--line:#e5e7eb;--card:#f8fafc;--accent:#2456d6;
--ok:#137a44;--okbg:#e7f6ee;--bad:#b91c1c;--badbg:#fdecec;--newbad:#e11d48;--warn:#92600a;--warnbg:#fdf3dd}
@media (prefers-color-scheme: dark){:root{--bg:#101318;--fg:#e5e9f0;--muted:#94a3b8;--line:#2a3140;--card:#181d26;--accent:#7ea6ff;
--ok:#4ade80;--okbg:#12291c;--bad:#f87171;--badbg:#2d1516;--newbad:#fb7185;--warn:#fbbf24;--warnbg:#2b2412}}
*{box-sizing:border-box}
body{margin:0;font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--fg)}
header{display:flex;align-items:baseline;gap:1.5rem;padding:.8rem 1.2rem;border-bottom:1px solid var(--line);flex-wrap:wrap}
header h1{font-size:1rem;margin:0}
nav{display:flex;gap:.25rem}
nav a{color:var(--muted);text-decoration:none;padding:.25rem .6rem;border-radius:6px}
nav a:hover{color:var(--fg)}
nav a.active{color:var(--accent);background:var(--card);font-weight:600}
main{padding:1.2rem;max-width:1400px;margin:0 auto}
footer{padding:1rem 1.2rem;color:var(--muted);font-size:.8rem;border-top:1px solid var(--line)}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-bottom:1.2rem}
.tile{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.8rem 1rem}
.tile .n{font-size:1.6rem;font-weight:700}
.tile .l{color:var(--muted);font-size:.8rem}
.tile.bad .n{color:var(--bad)}.tile.ok .n{color:var(--ok)}.tile.newbad .n{color:var(--newbad)}
table{border-collapse:collapse;width:100%}
th,td{text-align:left;padding:.4rem .6rem;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;position:sticky;top:0;background:var(--bg)}
td code{font-size:.85rem;word-break:break-all}
.badge{display:inline-block;padding:.05rem .5rem;border-radius:999px;font-size:.75rem;white-space:nowrap}
.badge.violation{background:var(--badbg);color:var(--bad)}
.badge.new{background:var(--newbad);color:#fff}
.badge.conforming{background:var(--okbg);color:var(--ok)}
.badge.unused_allowance{background:var(--warnbg);color:var(--warn)}
.badge.tier{background:var(--card);border:1px solid var(--line);color:var(--muted)}
.controls{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:.9rem;align-items:center}
.controls input,.controls select{padding:.35rem .55rem;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--fg);font:inherit}
.controls .count{color:var(--muted);margin-left:auto}
.ev{color:var(--muted);font-size:.8rem}
h2{font-size:.95rem;margin:1.4rem 0 .5rem}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.2rem}
button.sort{border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:8px;padding:.3rem .6rem;cursor:pointer;font:inherit}
button.sort.on{color:var(--accent);border-color:var(--accent)}
#cv{width:100%;height:calc(100vh - 180px);border:1px solid var(--line);border-radius:10px;cursor:grab;touch-action:none}
#panel{position:fixed;right:1.2rem;bottom:1.2rem;max-width:340px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.8rem 1rem;display:none;font-size:.85rem}
#panel h3{margin:.1rem 0 .4rem;font-size:.9rem;word-break:break-all}
</style>
</head>
<body>
<header>
  <h1>DepPolicy</h1>
  <nav>
    <a href="index.html" {{if eq .Active "index.html"}}class="active"{{end}}>Summary</a>
    <a href="findings.html" {{if eq .Active "findings.html"}}class="active"{{end}}>Findings</a>
    <a href="components.html" {{if eq .Active "components.html"}}class="active"{{end}}>Components</a>
    <a href="graph.html" {{if eq .Active "graph.html"}}class="active"{{end}}>Graph</a>
    <a href="tiers.html" {{if eq .Active "tiers.html"}}class="active"{{end}}>Tiers</a>
  </nav>
</header>
<main>
{{end}}

{{define "foot"}}
</main>
<footer>Generated {{.GeneratedAt}} · policy: <code>{{.PolicyPath}}</code> · graph: <code>{{.GraphPath}}</code>{{if .Baseline}} · ratchet baseline applied{{end}} · read-only report — policy changes flow through promote / policy-diff review</footer>
</body>
</html>
{{end}}
